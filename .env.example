# Seguranca da sessao
JWT_SECRET=troque-por-uma-chave-longa-e-secreta
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Persistencia no Render
DATABASE_DIR=/var/data

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=token-da-meta
WHATSAPP_PHONE_NUMBER_ID=id-do-numero-whatsapp
WHATSAPP_TEMPLATE_NAME=cobranca_mensalidade
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
PIX_KEY=chave-pix-do-clube
PIX_WEBHOOK_SECRET=segredo-do-webhook-do-provedor

# Hora local de envio (Campo Grande)
TZ=America/Campo_Grande
COBRANCA_HORA=8
